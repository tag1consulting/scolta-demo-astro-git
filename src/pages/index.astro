---
// Home page: hero + section grid. The search widget lives in the global header
// (the layout) on every page, not in the home main content.
import Layout from "../layouts/Layout.astro";
import { manifestCount, manifestNav } from "../../lib/manifest.js";

const count = manifestCount();
const nav = manifestNav();
---

<Layout title="GitMastery — Master Git">
  <article class="prose hero">
    <h1>GitMastery</h1>
    <p>Master Git with {count} pages of reference docs in five languages.</p>
    <p class="hero__hint">
      Try searching: <em>undo my last commit</em>, <em>how to delete a branch</em>,
      <em>slow git</em>.
    </p>
  </article>

  <div class="section-grid">
    {
      nav.map((s) => (
        <section class="section-card">
          <h2>{s.section}</h2>
          <p class="section-card__count">{s.pages.length} page(s)</p>
          <ul>
            {s.pages.slice(0, 6).map((p) => (
              <li>
                <a href={p.url}>{p.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
